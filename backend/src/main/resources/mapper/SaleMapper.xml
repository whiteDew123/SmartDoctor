<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 销售地点 SQL 映射文件，对应接口 com.qst.medical.mapper.SaleMapper -->
<mapper namespace="com.qst.medical.mapper.SaleMapper">

    <!-- ==================== 结果映射 ==================== -->
    <resultMap id="BaseResultMap" type="com.qst.medical.entity.Sale">
        <id column="sale_id" property="saleId"/>
        <result column="sale_name" property="saleName"/>
        <result column="sale_phone" property="salePhone"/>
        <result column="createtime" property="createtime"/>
        <result column="updatetime" property="updatetime"/>
    </resultMap>

    <!-- ==================== 查询语句 ==================== -->

    <!-- 条件分页查询：使用 WHERE 1=1 兼容 PageHelper 分页插件 -->
    <select id="selectByPage" resultMap="BaseResultMap">
        SELECT sale_id, sale_name, sale_phone, createtime, updatetime
        FROM sale
        WHERE 1=1
        <if test="saleName != null and saleName != ''">
            AND sale_name LIKE CONCAT('%', #{saleName}, '%')
        </if>
        <if test="salePhone != null and salePhone != ''">
            AND sale_phone LIKE CONCAT('%', #{salePhone}, '%')
        </if>
        ORDER BY createtime DESC
    </select>

    <!-- 根据 ID 查询单个销售地点 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT sale_id, sale_name, sale_phone, createtime, updatetime
        FROM sale
        WHERE sale_id = #{saleId}
    </select>

    <!-- ==================== 新增语句 ==================== -->

    <!-- 添加销售地点：自增 ID 由数据库自动生成 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="saleId">
        INSERT INTO sale (sale_name, sale_phone, createtime, updatetime)
        VALUES (#{saleName}, #{salePhone}, #{createtime}, #{updatetime})
    </insert>

    <!-- ==================== 修改语句 ==================== -->

    <!-- 修改销售地点：根据 ID 更新药店名称、联系电话和更新时间 -->
    <update id="update">
        UPDATE sale
        SET sale_name = #{saleName},
            sale_phone = #{salePhone},
            updatetime = #{updatetime}
        WHERE sale_id = #{saleId}
    </update>

    <!-- ==================== 删除语句 ==================== -->

    <!-- 根据 ID 删除销售地点 -->
    <delete id="deleteById">
        DELETE FROM sale WHERE sale_id = #{saleId}
    </delete>
</mapper>