<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.qst.medical.mapper.SecurityLogMapper">

    <resultMap id="BaseResultMap" type="com.qst.medical.entity.SecurityLog">
        <id column="id" property="id"/>
        <result column="account_id" property="accountId"/>
        <result column="username" property="username"/>
        <result column="realname" property="realname"/>
        <result column="operation" property="operation"/>
        <result column="description" property="description"/>
        <result column="ip_address" property="ipAddress"/>
        <result column="user_agent" property="userAgent"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, account_id, username, realname, operation, description,
        ip_address, user_agent, status, create_time
    </sql>

    <insert id="insert" parameterType="com.qst.medical.entity.SecurityLog"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_log
        (account_id, username, realname, operation, description,
         ip_address, user_agent, status, create_time)
        VALUES
        (#{accountId}, #{username}, #{realname}, #{operation}, #{description},
         #{ipAddress}, #{userAgent}, #{status}, NOW())
    </insert>

    <select id="selectByCondition" parameterType="com.qst.medical.entity.SecurityLog"
            resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_log
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="realname != null and realname != ''">
                AND realname LIKE CONCAT('%', #{realname}, '%')
            </if>
            <if test="operation != null and operation != ''">
                AND operation = #{operation}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="beginTime != null and beginTime != ''">
                AND create_time &gt;= #{beginTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND create_time &lt;= #{endTime}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <delete id="deleteById" parameterType="long">
        DELETE FROM sys_log WHERE id = #{id}
    </delete>

    <delete id="deleteBatch" parameterType="list">
        DELETE FROM sys_log WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteBeforeDate" parameterType="string">
        DELETE FROM sys_log WHERE create_time &lt; #{date}
    </delete>

</mapper>
