<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qst.medical.mapper.SecurityLogMapper">

    <resultMap id="BaseResultMap" type="com.qst.medical.entity.SecurityLog">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="user_role" property="userRole"/>
        <result column="operation" property="operation"/>
        <result column="detail" property="detail"/>
        <result column="ip" property="ip"/>
        <result column="request_uri" property="requestUri"/>
        <result column="http_method" property="httpMethod"/>
        <result column="status" property="status"/>
        <result column="result" property="result"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.qst.medical.entity.SecurityLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO security_log (username, user_role, operation, detail, ip, request_uri, http_method, status, result, create_time)
        VALUES (#{username}, #{userRole}, #{operation}, #{detail}, #{ip}, #{requestUri}, #{httpMethod}, #{status}, #{result}, NOW())
    </insert>

    <select id="selectByPage" resultMap="BaseResultMap">
        SELECT * FROM security_log
        <where>
            <if test="operation != null and operation != ''">
                AND operation LIKE CONCAT('%', #{operation}, '%')
            </if>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="selectCount" resultType="java.lang.Long">
        SELECT COUNT(*) FROM security_log
        <where>
            <if test="operation != null and operation != ''">
                AND operation LIKE CONCAT('%', #{operation}, '%')
            </if>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM security_log WHERE id = #{id}
    </select>

    <delete id="deleteOlderThan">
        DELETE FROM security_log WHERE create_time &lt; #{before}
    </delete>
</mapper>