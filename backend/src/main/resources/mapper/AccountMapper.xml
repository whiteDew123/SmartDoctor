<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qst.medical.mapper.AccountMapper">

    <resultMap id="BaseResultMap" type="com.qst.medical.entity.Account">
        <id column="id" property="id"/>
        <result column="realname" property="realname"/>
        <result column="uname" property="uname"/>
        <result column="pwd" property="pwd"/>
        <result column="phonenumber" property="phonenumber"/>
        <result column="utype" property="utype"/>
        <result column="updatetime" property="updatetime"/>
        <result column="createtime" property="createtime"/>
    </resultMap>

    <select id="selectByUname" resultMap="BaseResultMap">
        SELECT * FROM account WHERE uname = #{uname}
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM account WHERE id = #{id}
    </select>

    <select id="selectByPhonenumber" resultMap="BaseResultMap">
        SELECT * FROM account
        WHERE phonenumber = #{phonenumber}
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
        LIMIT 1
    </select>

    <insert id="insert" parameterType="com.qst.medical.entity.Account" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO account (realname, uname, pwd, phonenumber, utype, createtime)
        VALUES (#{realname}, #{uname}, #{pwd}, #{phonenumber}, #{utype}, NOW())
    </insert>

    <update id="updateById" parameterType="com.qst.medical.entity.Account">
        UPDATE account
        <set>
            <if test="realname != null">realname = #{realname},</if>
            <if test="uname != null">uname = #{uname},</if>
            <if test="phonenumber != null">phonenumber = #{phonenumber},</if>
            <if test="utype != null">utype = #{utype},</if>
            updatetime = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <update id="updatePwd">
        UPDATE account SET pwd = #{pwd}, updatetime = NOW() WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM account WHERE id = #{id}
    </delete>

</mapper>
